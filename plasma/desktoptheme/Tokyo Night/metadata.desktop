[DesktopEntry]
Name=Tokyo-Night
Comment=Fan Favorite Tokyo Night Theme for Plasma Desktop

X-KDE-PluginInfo-Author=JayyDev
X-KDE-PluginInfo-Email=none25711@gmail.com
X-KDE-PluginInfo-License=GPL_V3
