[Desktop Entry]
Name=Tokyo Night
Comment=Tokyo Night Plasma Theme

X-KDE-PluginInfo-Author=Jayy-Dev
X-KDE-PluginInfo-Email=none25711@gmail.com
X-KDE-PluginInfo-EnabledByDefault=true
X-KDE-PluginInfo-License=GPL_3.0
X-KDE-PluginInfo-Name=Tokyo-Night
X-KDE-PluginInfo-Version=1.0.6-HOTFIX
X-KDE-PluginInfo-Website=https://github.com/Jayy-Dev/Plasma/Tokyo-Night

[Wallpaper]
defaultFileSuffix=.png
defaultWallpaperTheme=Tokyo-Night
defaultWidth=1920
defaultHeight=1080

[ContrastEffect]
enabled=false
contrast=0.17
intensity=1.25
saturation=9

[AdaptiveTransparency]
enabled=true
